@model List<SmartRecruitment.Models.ApplicantViewModel>

<h2 class="mb-3">Applicants</h2>


@if (Model == null || !Model.Any())

{

    <div class="alert alert-info">

        No Applications Applied Still.

    </div>

}
else
{


    <table class="table table-bordered table-hover">

        <thead class="table-dark">
            <tr>
                <th>Job</th>
                <th>Candidate</th>
                <th>Applied Date</th>
                <th>Mobile Number</th>
                <th>Resume</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.JobTitle</td>

                    <td>@item.CandidateName</td>

                    <td>@item.AppliedDate.ToShortDateString()</td>

                    <td>
                        @item.MobileNumber

                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2"
                                onclick="copyNumber('@item.MobileNumber')" title="Copy Number">

                            <i class="bi bi-clipboard">⧉</i>

                        </button>
                    </td>

                    <td>
                        <a href="@item.ResumePath" target="_blank" class="btn btn-primary btn-sm">

                            View Resume

                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>

}

<script>

    function copyNumber(number) {
        navigator.clipboard.writeText(number);

        alert("Number Copied: " + number);
    }

</script>