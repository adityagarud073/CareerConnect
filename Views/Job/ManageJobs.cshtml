@model List<SmartRecruitment.Models.Job>

@{
    ViewData["Title"] = "Manage Jobs";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-success text-white">

            <h3 class="mb-0">
                My Posted Jobs
            </h3>

        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No jobs posted yet.
                </div>
            }
            else
            {
                <table class="table table-hover table-bordered align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Job Title</th>
                            <th>Company</th>
                            <th>Skills</th>
                            <th>Experience</th>
                            <th>Location</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var job in Model)
                        {
                            <tr>

                                <td>@job.Title</td>

                                <td>@job.CompanyName</td>

                                <td>@job.RequiredSkills</td>

                                <td>@job.Experience</td>

                                <td>@job.Location</td>

                                <td>

                                    @* <a asp-action="EditJob" asp-route-id="@job.Id" class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="DeleteJob" asp-route-id="@job.Id" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this job?')">
                                        Delete
                                    </a> *@

                                
                                        <a asp-action="JobDetails" asp-route-id="@job.Id" class="btn btn-info btn-sm">
                                            View Details
                                        </a>

                                        <a asp-action="EditJob" asp-route-id="@job.Id" class="btn btn-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="DeleteJob" asp-route-id="@job.Id" class="btn btn-danger btn-sm"
                                           onclick="return confirm('Are you sure you want to delete this job?')">
                                            Delete
                                        </a>
                                    

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>