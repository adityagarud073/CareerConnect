@model SmartRecruitment.Models.Resume

@{
    ViewData["Title"] = "Upload Resume";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8 col-md-10">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center py-4">

                    <h2 class="mb-1">
                        Resume Portal
                    </h2>

                    <p class="mb-0">
                        Upload or Update Your Resume
                    </p>

                </div>

                <div class="card-body p-4">

                    @* @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">

                            @TempData["Success"]

                            <button type="button" class="btn-close" data-bs-dismiss="alert">
                            </button>

                        </div>
                    } *@

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">

                            @TempData["Error"]

                            <button type="button" class="btn-close" data-bs-dismiss="alert">
                            </button>

                        </div>
                    }

                    @if (Model != null && !string.IsNullOrEmpty(Model.ResumePath))
                    {
                        <div class="alert alert-info">

                            <h5 class="fw-bold">
                                Your Resume Already Uploaded
                            </h5>

                            <hr />

                            <p>
                                <strong>
                                    Mobile Number :
                                </strong>

                                @Model.MobileNumber
                            </p>

                            <a href="@Model.ResumePath" target="_blank" class="btn btn-success">

                                View Existing Resume

                            </a>

                        </div>
                    }

                    <form method="post" enctype="multipart/form-data">

                        <div class="mb-4">

                            <label class="form-label fw-bold">

                                Mobile Number

                            </label>

                            <input type="tel" name="mobileNumber" maxlength="10" pattern="[0-9]{10}"
                                   value="@Model?.MobileNumber" class="form-control form-control-lg"
                                   placeholder="Enter 10 Digit Mobile Number"
                                   oninput="this.value=this.value.replace(/[^0-9]/g,'')" required />

                            <small class="text-muted">
                                Enter only 10 digit mobile number.
                            </small>

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-bold">

                                Upload Resume (PDF)

                            </label>

                            @if (Model == null)
                            {
                                <input type="file" name="resumeFile" accept=".pdf" class="form-control form-control-lg"
                                       required />
                            }
                            else
                            {
                                <input type="file" name="resumeFile" accept=".pdf" class="form-control form-control-lg" />
                            }

                            <small class="text-muted">
                                Only PDF files are allowed.
                            </small>

                        </div>

                        @if (Model != null &&
                             !string.IsNullOrEmpty(Model.ResumePath))
                        {
                            <div class="d-grid">

                                <button type="submit" class="btn btn-warning btn-lg fw-bold">

                                    Change Existing Resume

                                </button>

                            </div>
                        }
                        else
                        {
                            <div class="d-grid">

                                <button type="submit" class="btn btn-primary btn-lg fw-bold">

                                    Upload Resume

                                </button>

                            </div>
                        }

                    </form>

                </div>


            </div>

        </div>

    </div>

</div>