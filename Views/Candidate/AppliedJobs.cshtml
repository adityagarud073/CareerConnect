@model dynamic

@{
    ViewData["Title"] = "My Applied Jobs";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">

            <h3 class="mb-0">
                My Applied Jobs
            </h3>

        </div>

        <div class="card-body">

            <table class="table table-hover table-bordered align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Job Title</th>

                        <th>Location</th>

                        <th>Applied Date</th>

                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.Title
                            </td>

                            <td>
                                @item.Location
                            </td>

                            <td>
                                @item.AppliedDate
                            </td>

                            <td>

                                <a asp-controller="Job" asp-action="JobDetails" asp-route-id="@item.JobId"
                                   class="btn btn-primary btn-sm">

                                    View Details

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>