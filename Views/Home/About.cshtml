@{
    ViewData["Title"] = "About";
}

<div class="container mt-4">

    <h2>About CareerConnect</h2>

    <p class="mt-3">
        CareerConnect is a web-based job portal developed
        using ASP.NET Core MVC, Entity Framework Core, MySQL, and Bootstrap.
        The system provides separate modules for Candidates and Recruiters to
        simplify the hiring process. Candidates can upload resumes and apply
        for jobs, while Recruiters can post jobs, manage job listings, and
        review applicants through a centralized dashboard.
    </p>

    <hr />

    <h3>Candidate Module</h3>

    <ul>
        <li>Register and Login to the system.</li>
        <li>Upload Resume and Apply for Jobs.</li>
        <li>View Available Jobs and Applied Jobs.</li>
        <li>View Job Details and Application Information.</li>
    </ul>

    <hr />

    <h3>Recruiter Module</h3>

    <ul>
        <li>Register and Login to the system.</li>
        <li>Add, Edit, and Delete Job Postings.</li>
        <li>View Posted Jobs and Applicants.</li>
        <li>Access Candidate Resumes and Manage Recruitment Activities.</li>
    </ul>

</div>