@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="bg-primary text-white rounded-4 p-5 mt-4 shadow">

    <div class="row align-items-center">

        <div class="col-md-7">

            <h1 class="display-3 fw-bold">
                CareerConnect
            </h1>

            <p class="lead mt-3">
                Connecting talented candidates with the right
                recruiters through a simple and efficient
                recruitment platform.
            </p>

            <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg me-2">
                Get Started
            </a>

            <a asp-controller="Home" asp-action="About" class="btn btn-outline-light btn-lg">
                Learn More
            </a>

        </div>

        <div class="col-md-5 text-center">

            <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" class="img-fluid"
                 style="max-height:250px;" />

        </div>

    </div>

</div>

<!-- Features Section -->
<div class="container mt-5">

    <h2 class="text-center mb-4">
        Key Features
    </h2>

    <div class="row">

        <div class="col-md-4 mb-3">

            <div class="card shadow h-100 border-0">

                <div class="card-body text-center">

                    <h3>👨‍💼</h3>

                    <h5>Candidate Module</h5>

                    <p>
                        Upload resumes, view jobs,
                        apply for opportunities and
                        track applications.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card shadow h-100 border-0">

                <div class="card-body text-center">

                    <h3>🏢</h3>

                    <h5>Recruiter Module</h5>

                    <p>
                        Add jobs, manage postings,
                        review applicants and access resumes.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card shadow h-100 border-0">

                <div class="card-body text-center">

                    <h3>⚡</h3>

                    <h5>Easy Management</h5>

                    <p>
                        Manage recruitment activities
                        efficiently through a centralized dashboard.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Footer Info -->
<div class="container mt-5 mb-5">

    <div class="card border-0 shadow">

        <div class="card-body text-center">

            <h4>Why CareerConnect?</h4>

            <p>
                CareerConnect is a web-based job portal that connects candidates and recruiters on a single platform.
                Candidates can search and apply for jobs, while recruiters can manage job postings and review applicants
                efficiently.
            </p>

        </div>

    </div>

</div>